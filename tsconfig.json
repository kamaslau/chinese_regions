{
  "extends": "@tsconfig/node26/tsconfig.json",
  "include": ["src/**/*", "types"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "typeRoots": ["node_modules/@types", "types"],
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true
  }
}
