{
  "name": "chinese_regions",
  "version": "0.5.5",
  "description": "中华人民共和国民政部省、市、区/县级行政区划代码及名称。港澳台地区等均已包含。当前数据最后更新于2025年5月14日，根据中华人民共和国民政部于2024年04月25日最新发布的数据生成。",
  "keywords": [
    "省市区",
    "行政区",
    "中国",
    "中华人民共和国",
    "prc",
    "china",
    "regions",
    "province",
    "city",
    "district",
    "county",
    "taiwan",
    "hongkong",
    "macao"
  ],
  "author": "Lau, Kamas <kamaslau@dingtalk.com> (https://www.kamaslau.com/)",
  "license": "MIT",
  "engines": {
    "node": "^26 || >=24"
  },
  "type": "module",
  "main": "out/all.min.json",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env.local dist/app.js",
    "start:dev": "node --env-file=.env.local --watch=.env.local --watch=pnpm-lock.yaml --watch=tsconfig.json --watch-path=./src --watch-path=./types src/app.ts",
    "test": "node --test",
    "lint": "eslint --fix .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node26": "^26.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/koa": "^3.0.3",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cheerio": "^1.2.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@koa/router": "^15.7.1",
    "fs-extra": "^11.4.1",
    "koa": "^3.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamaslau/chinese_regions.git"
  },
  "bugs": {
    "url": "https://github.com/kamaslau/chinese_regions/issues"
  },
  "homepage": "https://github.com/kamaslau/chinese_regions#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
